# Register the Vertex API key at: https://console.cloud.google.com/vertex-ai/studio/settings/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

QWEN_API_KEY=your_qwen_api_key_here
LLM_PROVIDER=qwen
LLM_MODEL=qwen-max
# Email address associated with your Apple account
CALDAV_USERNAME=your_apple_id_here

# Register the Apple API key at: https://account.apple.com/account/manage with "App-Specific Passwords"
CALDAV_PASSWORD=your_apple_api_key_here

# The URL for the CalDAV server (for iCloud, it's typically https://caldav.icloud.com)
CALDAV_URL=https://caldav.icloud.com
CALENDAR_NAME=your_calendar_name_here

VOICE_WAKE_WORDS=hey calendar

# The address of Pi 1 /voice endpoint
VOICE_SERVER_URL=http://localhost:5888/voice

# The address of Pi 2 /speak endpoint
PI2_VOICE_AGENT_URL=http://localhost:5890/speak